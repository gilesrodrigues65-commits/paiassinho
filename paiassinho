local function char()
    local c = LP.Character
    if not c then return end
    local h = c:FindFirstChild("HumanoidRootPart")
    local m = c:FindFirstChildOfClass("Humanoid")
    if h and m and m.Health > 0 then return c, h, m end
end

local function isCuff(t)
    if not t or not t:IsA("Tool") then return false end
    local n = string.lower(t.Name)
    for _, k in ipairs(CFG.AA.KW) do if string.find(n, k, 1, true) then return true end end
    return false
end

local function hasEquippedCuff(pl)
    if pl == LP then return false end
    local c = pl.Character
    if not c then return false end
    local t = c:FindFirstChildOfClass("Tool")
    return t and isCuff(t) or false
end

