--======================= AUTOKILL =======================
local AK = {}
do
    local monitoring = false
    local processed = false
    local listenerConn = nil

    local function isPrisonActive()
        local pg = LP:FindFirstChild("PlayerGui")
        if not pg then return false end
        local ui = pg:FindFirstChild("PrisonResistance")
        if ui and ui:IsA("ScreenGui") then
            return ui.Enabled == true
        end
        return false
    end

    local function matar()
        if not monitoring or processed then return end
        processed = true
        pcall(function()
            local c, _, hum = char()
            if c and hum then
                hum.Health = 0
                c:BreakJoints()
            end
        end)
    end

    local function setupAnimListener(c)
        local hum = c:WaitForChild("Humanoid", 5)
        local animator = hum and hum:WaitForChild("Animator", 5)
        if not animator then return end
        if listenerConn then listenerConn:Disconnect() end
        listenerConn = animator.AnimationPlayed:Connect(function(track)
            if not monitoring or processed then return end
            if track.Animation and track.Animation.AnimationId == CFG.AK.ANIM_ID then
                if isPrisonActive() then matar() end
            end
        end)
    end

    function AK.start()
        if monitoring then return end
        monitoring = true
        processed = false

        local pg = LP:WaitForChild("PlayerGui")
        pg.ChildAdded:Connect(function(child)
            if monitoring and not processed and child.Name == "PrisonResistance" and child:IsA("ScreenGui") then
                if child.Enabled then matar() end
            end
        end)

        local c = LP.Character
        if c then setupAnimListener(c) end
        LP.CharacterAdded:Connect(function(newC) setupAnimListener(newC) end)

        task.spawn(function()
            while monitoring do
                if not processed then
                    local c, _, hum = char()
                    if c and hum then
                        if isPrisonActive() then matar() end
                        local animator = hum:FindFirstChildOfClass("Animator")
                        if animator then
                            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                                if track.Animation and track.Animation.AnimationId == CFG.AK.ANIM_ID then
                                    if isPrisonActive() then matar() end
                                    break
                                end
                            end
                        end
                    end
                end
                task.wait(0.1)
            end
        end)

        LP.CharacterAdded:Connect(function()
            task.wait(1.5)
            processed = false
        end)
    end

    function AK.stop()
        monitoring = false
        processed = false
        if listenerConn then listenerConn:Disconnect(); listenerConn = nil end
    end
end

--======================= ANTI ALGEMA =======================
local AA = {}
do
    local conn = nil; local lastAlert = 0
    function AA.start()
        if conn then return end
        conn = R.Heartbeat:Connect(function()
            if not ST.AA then return end
            local _, h = char(); if not h then return end
            local ts = {}
            for _, pl in ipairs(P:GetPlayers()) do
                if pl ~= LP and hasEquippedCuff(pl) then
                    local c = pl.Character; local hr = c and c:FindFirstChild("HumanoidRootPart")
                    if hr and (hr.Position - h.Position).Magnitude <= CFG.AA.RAD then table.insert(ts, hr) end
                end
            end
            if #ts > 0 and os.clock() - lastAlert > CFG.AA.CD then
                local o = h.Position; local best, bestScore = nil, math.huge
                for i = 0, 11 do
                    local a = (i/12)*math.pi*2; local dir = Vector3.new(math.cos(a), 0, math.sin(a)); local s = 0
                    for _, th in ipairs(ts) do local v = th.Position - o; v = Vector3.new(v.X, 0, v.Z); if v.Magnitude > 0 then s = s + dir:Dot(v.Unit) end end
                    if s < bestScore then bestScore = s; best = dir end
                end
                if best then pcall(function() h.CFrame = CFrame.new(o + best * CFG.AA.ESCAPE_DIST) end); lastAlert = os.clock() end
            end
        end)
    end
    function AA.stop() if conn then conn:Disconnect(); conn = nil end end
end

--======================= SPAWNKILL (0.1s após renascer) =======================
local SK = {}
do
    local saved = nil
    local dying = false
    local hbConn = nil
    local charAddedConn = nil
    local diedConn = nil

    local function isValidPos(h)
        return h and h.Position.Y > -100 and h.Position.Y < 100000
    end

    local function track()
        if dying then return end
        local c, h, hum = char()
        if h and hum and hum.Health > 0 and isValidPos(h) then
            saved = h.CFrame
        end
    end

    local function onDied()
        dying = true
        local c, h, hum = char()
        if h and isValidPos(h) then
            saved = h.CFrame
        end
    end

    local function onSpawn(c)
        if not ST.SK or not saved then return end
        task.spawn(function()
            local h = c:FindFirstChild("HumanoidRootPart")
            if not h then
                h = c:WaitForChild("HumanoidRootPart", CFG.SK.TIMEOUT)
            end
            if not h then return end
            task.wait(0.1) -- atraso de 0.1s após renascer
            if not ST.SK then return end
            pcall(function() h.CFrame = saved end)
            dying = false
        end)
    end

    local function hookChar(c)
        if diedConn then diedConn:Disconnect(); diedConn = nil end
        local hum = c:WaitForChild("Humanoid", 5)
        if hum then
            diedConn = hum.Died:Connect(onDied)
        end
    end

    function SK.start()
        if hbConn then return end
        dying = false

        hbConn = R.Heartbeat:Connect(track)

        charAddedConn = LP.CharacterAdded:Connect(function(c)
            hookChar(c)
            onSpawn(c)
        end)

        local c = LP.Character
        if c then hookChar(c) end
    end

    function SK.stop()
        if hbConn then hbConn:Disconnect(); hbConn = nil end
        if charAddedConn then charAddedConn:Disconnect(); charAddedConn = nil end
        if diedConn then diedConn:Disconnect(); diedConn = nil end
        dying = false
    end
end

