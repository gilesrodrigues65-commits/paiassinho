--======================= NOCLIP =======================
local NC = {}
do
    local stepConn = nil
    local respawnConn = nil

    local function apply(c, state)
        if not c then return end
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("BasePart") then
                d.CanCollide = state
            end
        end
    end

    function NC.start()
        if stepConn then return end
        apply(LP.Character, false)
        stepConn = R.Stepped:Connect(function()
            if not ST.NC then return end
            apply(LP.Character, false)
        end)
        respawnConn = LP.CharacterAdded:Connect(function(c)
            task.wait(0.1)
            if ST.NC then apply(c, false) else apply(c, true) end
        end)
    end

    function NC.stop()
        if stepConn then stepConn:Disconnect(); stepConn = nil end
        if respawnConn then respawnConn:Disconnect(); respawnConn = nil end
        apply(LP.Character, true)
        local n = 0
        task.spawn(function()
            while n < 30 do
                if ST.NC then break end
                apply(LP.Character, true)
                n = n + 1
                task.wait()
            end
        end)
    end
end

--======================= TP (3 INICIAIS) =======================
local TP = {}
do
    local findTarget = function(prefix)
        prefix = string.lower(prefix)
        for _, pl in ipairs(P:GetPlayers()) do
            if pl ~= LP then
                local nick = string.lower(pl.Name)
                if string.sub(nick, 1, #prefix) == prefix then
                    return pl
                end
            end
        end
        return nil
    end

    function TP.go(prefix)
        prefix = string.gsub(prefix or "", "%s", "")
        if #prefix < 1 then
            tpBox.PlaceholderText = "Digite as 3 iniciais do nick..."
            return
        end

        local target = findTarget(prefix)
        if not target then
            tpBox.Text = ""
            tpBox.PlaceholderText = "Ninguém com '" .. prefix .. "'"
            return
        end

        local tc = target.Character
        local thr = tc and tc:FindFirstChild("HumanoidRootPart")
        if not thr then
            tpBox.Text = ""
            tpBox.PlaceholderText = target.Name .. " sem personagem"
            return
        end

        local c, hr = char()
        if not hr then
            tpBox.Text = ""
            tpBox.PlaceholderText = "Você sem personagem"
            return
        end

        local targetCF = thr.CFrame
        local frontOffset = targetCF.LookVector * 4
        local destCF = CFrame.new(targetCF.Position + frontOffset, targetCF.Position + frontOffset + targetCF.LookVector)

        pcall(function() hr.CFrame = destCF end)

        tpBox.Text = ""
        tpBox.PlaceholderText = "TP -> " .. target.Name
    end
end

